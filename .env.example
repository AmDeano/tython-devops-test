# Copier ce fichier en `.env` puis remplacer les valeurs. Le fichier `.env` est ignoré par git.

# --- PostgreSQL ---
POSTGRES_DB=tython
POSTGRES_USER=tython
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
NODE_ENV=production
APP_VERSION=local

# --- Ports publiés sur l'hôte (dev local) ---
FRONTEND_PORT=8080

# --- Production (docker-compose.prod.yml) ---
# Registre et tag des images publiées par la CI (GHCR).
IMAGE_REGISTRY=ghcr.io/<github-user>/<repo>
IMAGE_TAG=latest
# Domaine public et e-mail Let's Encrypt.
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=admin@example.com

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
