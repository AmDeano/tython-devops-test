# copi had l fichier f .env w bdel les valeurs. .env ma kaytcommitach (kayn f .gitignore)

# --- PostgreSQL ---
POSTGRES_DB=tython
POSTGRES_USER=tython
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
NODE_ENV=production
APP_VERSION=local

# --- port f la machine (local) ---
FRONTEND_PORT=8080

# --- Prod (docker-compose.prod.yml) ---
# registry fin kaypushi l CI les images (GHCR), b minuscules
IMAGE_REGISTRY=ghcr.io/<github-user>/<repo>
IMAGE_TAG=latest
# domaine w email dyal let's encrypt
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=admin@example.com

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
